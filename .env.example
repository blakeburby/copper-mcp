# Copper MCP (Playwright edition) configuration.
#
# This server authenticates through the Copper WEB APP using a real browser
# session — there is NO API key and NO Copper credentials in this file. You log
# in manually once (SSO / password / MFA) via `initialize_copper_session`, and
# the session is persisted in the browser profile directory below.
#
# Copy to `.env` for local runs, or set these in the Claude Desktop / Claude Code
# MCP server `env` block. All values are optional; sane defaults are shown.

# Base URL of the Copper web app.
COPPER_BASE_URL=https://app.copper.com

# Directory where the persistent browser profile (cookies/session) is stored.
# Keep this OUT of version control — it contains your logged-in session.
COPPER_USER_DATA_DIR=./.copper-profile

# Run the browser with a visible window (true) or headless (false).
# First-time login MUST be headed. After the session is saved you can flip to
# headless=true for day-to-day use.
COPPER_HEADLESS=false

# Default per-action timeout (locator waits, clicks) in milliseconds.
COPPER_DEFAULT_TIMEOUT_MS=30000

# Navigation timeout (page.goto / waitForURL) in milliseconds.
COPPER_NAVIGATION_TIMEOUT_MS=45000

# Where failure screenshots / HTML snapshots are written.
COPPER_SCREENSHOT_DIR=./artifacts/screenshots

# Log verbosity: error | warn | info | debug
LOG_LEVEL=info
